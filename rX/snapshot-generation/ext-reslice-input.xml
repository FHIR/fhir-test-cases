<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <url value="http://example.org/fhir/StructureDefinition/ext-reslice"/>
  <name value="ExtReslice"/>
  <status value="draft"/>
  <description value="Shaped like FR Core Patient INS, as SUSHI made it (fhir-ig-publisher#846): reslices the inherited extension slice identityReliability, fixes a sub-extension value in the reslice, and then makes the later inherited slice birthPlace required"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Patient"/>
  <baseDefinition value="http://example.org/fhir/StructureDefinition/ext-reslice-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.extension:identityReliability/identite-vali">
      <path value="Patient.extension"/>
      <sliceName value="identityReliability/identite-vali"/>
      <min value="1"/>
      <max value="1"/>
    </element>
    <element id="Patient.extension:identityReliability/identite-vali.extension:identityStatus">
      <path value="Patient.extension.extension"/>
      <sliceName value="identityStatus"/>
    </element>
    <element id="Patient.extension:identityReliability/identite-vali.extension:identityStatus.value[x]">
      <path value="Patient.extension.extension.value[x]"/>
      <patternCoding>
        <system value="http://example.org/fhir/CodeSystem/identity-status"/>
        <code value="VALI"/>
      </patternCoding>
    </element>
    <element id="Patient.extension:birthPlace">
      <path value="Patient.extension"/>
      <sliceName value="birthPlace"/>
      <min value="1"/>
    </element>
  </differential>
</StructureDefinition>
