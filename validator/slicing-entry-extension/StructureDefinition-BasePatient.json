          {
            "code": "Extension",
            "profile": [
              "http://hl7.org/fhir/test/StructureDefinition/link-kind"
            ]
          }
        ]
      },
      {
        "id": "Patient.link:replacedBy",
        "path": "Patient.link",
        "sliceName": "replacedBy",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Patient.link:replacedBy.extension:kind",
        "path": "Patient.link.extension",
        "sliceName": "kind",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://hl7.org/fhir/test/StructureDefinition/link-kind"
            ]
          }
        ]
      },
      {
        "id": "Patient.link:replacedBy.type",
        "path": "Patient.link.type",
        "patternCode": "replaced-by"
      }
    ]
  }
