{
  "resourceType": "StructureDefinition",
  "id": "BasePatient",
  "url": "http://hl7.org/fhir/test/StructureDefinition/BasePatient",
  "version": "0.1.0",
  "name": "BasePatient",
  "title": "Base Patient",
  "status": "draft",
  "description": "Slices link by type and defines the kind extension on the slicing entry, so every link may carry it.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Patient.link",
        "path": "Patient.link",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "type"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "Patient.link.extension",
        "path": "Patient.link.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
