<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="inv-impose-source"/> 
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-imposeProfile">
    <valueCanonical value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-target"/> 
  </extension> 
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-imposeProfile">
    <valueCanonical value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-missing"/> 
  </extension> 
  <url value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-source"/> 
  <name value="InvImposeSource"/> 
  <title value="Invariant Impose Source"/> 
  <status value="draft"/> 
  <description value="Variants of ElementDefinition.constraint.source naming a profile other than this one. That is only legal if this profile imposes the named profile, and then only if the invariant really is the same one"/> 
  <fhirVersion value="5.0.0"/> 
  <kind value="resource"/> 
  <abstract value="false"/> 
  <type value="Patient"/> 
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/> 
  <derivation value="constraint"/> 
  <differential> 
    <element id="Patient.identifier">
      <path value="Patient.identifier"/> 
      <constraint> 
        <key value="imp-1"/> 
        <severity value="error"/> 
        <human value="Identifiers must have a system"/> 
        <expression value="system.exists()"/> 
        <source value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-target"/> 
      </constraint> 
    </element> 
    <element id="Patient.name">
      <path value="Patient.name"/> 
      <constraint> 
        <key value="imp-2"/> 
        <severity value="error"/> 
        <human value="Names must have text"/> 
        <expression value="text.exists()"/> 
        <source value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-other"/> 
      </constraint> 
    </element> 
    <element id="Patient.telecom">
      <path value="Patient.telecom"/> 
      <constraint> 
        <key value="imp-4"/> 
        <severity value="error"/> 
        <human value="Contact points must have a system"/> 
        <expression value="system.exists()"/> 
        <source value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-missing"/> 
      </constraint> 
    </element> 
    <element id="Patient.address">
      <path value="Patient.address"/> 
      <constraint> 
        <key value="imp-3"/> 
        <severity value="error"/> 
        <human value="Addresses must have a country"/> 
        <expression value="city.exists()"/> 
        <source value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-target"/> 
      </constraint> 
    </element> 
  </differential> 
</StructureDefinition> 
