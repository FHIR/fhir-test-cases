<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="sd-root-profile"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/sd-root-profile"/>
  <name value="SdRootProfile"/>
  <title value="sd-root-profile"/>
  <status value="draft"/>
  <description value="Data type profile whose root element sets every property that is not allowed on the root of a profile: contentReference, condition, meaningWhenMissing, orderMeaning, and changes isModifier, isModifierReason and isSummary from the base"/>
  <fhirVersion value="5.0.0"/>
  <kind value="complex-type"/>
  <abstract value="false"/>
  <type value="CodeableConcept"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/CodeableConcept"/>
  <derivation value="constraint"/>
  <differential>
    <element id="CodeableConcept">
      <path value="CodeableConcept"/>
      <!-- never allowed on a root: there's nothing before the root for it to refer to -->
      <contentReference value="#CodeableConcept"/>
      <!-- not allowed on the root of anything but a logical model -->
      <meaningWhenMissing value="means nothing in particular"/>
      <orderMeaning value="ordered by importance"/>
      <!-- never allowed on a root: whether an element is allowed can't depend on its own content -->
      <condition value="ele-1"/>
      <!-- a profile cannot change these from the base (base: isModifier = false, no reason, no isSummary) -->
      <isModifier value="true"/>
      <isModifierReason value="because the root says so"/>
      <isSummary value="true"/>
    </element>
  </differential>
</StructureDefinition>
