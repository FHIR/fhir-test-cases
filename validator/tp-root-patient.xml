<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="tp-root-patient"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/tp-root-patient"/>
  <name value="TpRootPatient"/>
  <status value="draft"/>
  <description value="Patient profile that uses the two data type profiles, so their root constraints are both merged into the snapshot and checked through the type profile"/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Patient"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.name.family">
      <path value="Patient.name.family"/>
      <type>
        <code value="string"/>
        <profile value="http://hl7.org/fhir/test/StructureDefinition/tp-root-string"/>
      </type>
    </element>
    <element id="Patient.maritalStatus">
      <path value="Patient.maritalStatus"/>
      <type>
        <code value="CodeableConcept"/>
        <profile value="http://hl7.org/fhir/test/StructureDefinition/tp-root-cc"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
