<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="inv-impose-other"/> 
  <url value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-other"/> 
  <name value="InvImposeOther"/> 
  <title value="Invariant Impose Other"/> 
  <status value="draft"/> 
  <description value="A profile that defines an invariant (imp-2) and that inv-impose-source does NOT impose - so inv-impose-source may not claim it as the source of an invariant, even though the invariant really is defined here"/> 
  <fhirVersion value="5.0.0"/> 
  <kind value="resource"/> 
  <abstract value="false"/> 
  <type value="Patient"/> 
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/> 
  <derivation value="constraint"/> 
  <differential> 
    <element id="Patient.name">
      <path value="Patient.name"/> 
      <constraint> 
        <key value="imp-2"/> 
        <severity value="error"/> 
        <human value="Names must have text"/> 
        <expression value="text.exists()"/> 
        <source value="http://hl7.org/fhir/test/StructureDefinition/inv-impose-other"/> 
      </constraint> 
    </element> 
  </differential> 
</StructureDefinition> 
