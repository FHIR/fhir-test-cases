  <fhirVersion value="5.0.0"/>
  <kind value="complex-type"/>
  <abstract value="false"/>
  <type value="CodeableConcept"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/CodeableConcept"/>
