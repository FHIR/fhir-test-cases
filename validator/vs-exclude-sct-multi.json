{
  "resourceType": "ValueSet",
  "id": "vs-exclude-sct-multi",
  "url": "http://hl7.org/fhir/test/ValueSet/vs-exclude-sct-multi",
  "version": "1.0.0",
  "name": "VSExcludeSctMulti",
  "title": "Exclude from SNOMED CT across servers",
  "status": "active",
  "experimental": false,
  "date": "2026-11-10",
  "publisher": "FHIR Project",
  "description": "SNOMED CT filter includes from the International and Estonian editions, each with explicit code and filter excludes. The Estonian edition is only on term.tehik.ee, which also serves the International edition, so a single server can expand it all (see fhir-ig-publisher#1469; compare vs-exclude-sct-split, which needs two servers)",
  "compose": {
    "include": [
      {
        "system": "http://snomed.info/sct",
        "filter": [
          {
            "property": "concept",
            "op": "is-a",
            "value": "46635009"
          }
        ]
      },
      {
        "system": "http://snomed.info/sct",
        "version": "http://snomed.info/sct/11000181102",
        "filter": [
          {
            "property": "concept",
            "op": "is-a",
            "value": "49436004"
          }
        ]
      }
    ],
    "exclude": [
      {
        "system": "http://snomed.info/sct",
        "concept": [
          {
            "code": "290002008"
          }
        ]
      },
      {
        "system": "http://snomed.info/sct",
        "filter": [
          {
            "property": "concept",
            "op": "is-a",
            "value": "70694009"
          }
        ]
      },
      {
        "system": "http://snomed.info/sct",
        "version": "http://snomed.info/sct/11000181102",
        "concept": [
          {
            "code": "314208002"
          }
        ]
      },
      {
        "system": "http://snomed.info/sct",
        "version": "http://snomed.info/sct/11000181102",
        "filter": [
          {
            "property": "concept",
            "op": "is-a",
            "value": "282825002"
          }
        ]
      }
    ]
  }
}
