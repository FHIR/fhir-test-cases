<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="sd-root-extension"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/sd-root-extension"/>
  <name value="SdRootExtension"/>
  <title value="sd-root-extension"/>
  <status value="draft"/>
  <description value="Modifier extension whose root element sets meaningWhenMissing, isModifier and isModifierReason - all allowed on the root of an extension"/>
  <fhirVersion value="5.0.0"/>
  <kind value="complex-type"/>
  <abstract value="false"/>
  <context>
    <type value="element"/>
    <expression value="Patient"/>
  </context>
  <type value="Extension"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Extension"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Extension">
      <path value="Extension"/>
      <short value="root test extension"/>
      <definition value="root test extension"/>
      <!-- allowed on an extension: what it means when the extension is absent -->
      <meaningWhenMissing value="the default applies"/>
      <!-- allowed on an extension: it is a modifier extension -->
      <isModifier value="true"/>
      <isModifierReason value="because the root says so"/>
    </element>
    <element id="Extension.extension">
      <path value="Extension.extension"/>
      <max value="0"/>
    </element>
    <element id="Extension.url">
      <path value="Extension.url"/>
      <fixedUri value="http://hl7.org/fhir/test/StructureDefinition/sd-root-extension"/>
    </element>
    <element id="Extension.value[x]">
      <path value="Extension.value[x]"/>
      <type>
        <code value="boolean"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
