            "expression": "entry.resource.where(id = 'weight-bad').conformsTo('hl7.fhir.test.conformsto#0.1.0')"
          },
          {
            "key": "ig-13",
            "severity": "error",
            "human": "weight-good conforms to the IG: named by url and version",
            "expression": "entry.resource.where(id = 'weight-good').conformsTo('http://hl7.org/fhir/test/ImplementationGuide/conformsto-ig|0.1.0')"
          },
          {
            "key": "ig-14",
            "severity": "error",
            "human": "weight-good conforms to the IG: names neither a profile nor an IG",
            "expression": "entry.resource.where(id = 'weight-good').conformsTo('hl7.fhir.test.not-an-ig')"
          }
        ]
      }
    ]
  }
}