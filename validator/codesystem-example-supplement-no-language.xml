<?xml version="1.0" encoding="UTF-8"?>

<CodeSystem xmlns="http://hl7.org/fhir">
  <id value="example-supplement-no-language"/> 
  <!-- A supplement that does not say what language it is in (no CodeSystem.language): its display, and its
    designation with no language, are correct displays in any language, which gets a warning. Its designation
    with a language (fr) is only a display in French -->
  <url value="http://hl7.org/fhir/CodeSystem/example-supplement-no-language"/> 
  <version value="1.0.0"/> 
  <name value="SupplementNoLanguageExample"/> 
  <title value="Supplement with no language for composition-status CodeSystem"/> 
  <status value="draft"/> 
  <experimental value="true"/> 
  <date value="2026-11-02"/> 
  <publisher value="Acme Co"/> 
  <contact> 
    <name value="FHIR project team"/> 
    <telecom> 
      <system value="url"/> 
      <value value="http://hl7.org/fhir"/> 
    </telecom> 
  </contact> 
  <description value="This is an example supplement code system for the composition-status CodeSystem that does not say what language it is in"/> 
  <content value="supplement"/>
  <supplements value="http://hl7.org/fhir/composition-status|5.0.0"/>
  <concept> 
    <code value="final"/>
    <display value="Done"/>
    <definition value="The composition is complete"/>
    <designation> 
      <value value="Completed"/> 
    </designation> 
    <designation> 
      <language value="fr"/>
      <value value="Terminé"/> 
    </designation> 
  </concept> 
</CodeSystem>
