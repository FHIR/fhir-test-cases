<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="l17d-resource"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/l17d-resource"/>
  <name value="L17dResourceName"/>
  <title value="L17d Resource Title"/>
  <status value="draft"/>
  <publisher value="FHIR"/>
  <description value="Adds slice 'b' to the component slicing inherited from l17d-base, and constrains its children: like slice 'a', slice 'b' and its children don't get the slicer's invariant or the constraint on the slicer's child"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="true"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/test/StructureDefinition/l17d-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.component:b">
      <path value="Observation.component"/>
      <sliceName value="b"/>
      <max value="1"/>
    </element>
    <element id="Observation.component:b.code">
      <path value="Observation.component.code"/>
      <patternCodeableConcept>
        <coding>
          <system value="http://example.org/codes"/>
          <code value="b"/>
        </coding>
      </patternCodeableConcept>
    </element>
    <element id="Observation.component:b.value[x]">
      <path value="Observation.component.value[x]"/>
      <type>
        <code value="Quantity"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
