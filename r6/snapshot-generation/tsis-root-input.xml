<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="tsis-root"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/tsis-root"/>
  <name value="TsisRootName"/>
  <title value="Tsis Root Title"/>
  <status value="draft"/>
  <publisher value="FHIR"/>
  <description value="The root level version of tsis-shortcut: uses the type specific name (valueQuantity) where the base has restricted value[x] to Quantity, not type sliced it, and expanded its children. The snapshot has a closed type slicer on value[x] with one valueQuantity slice - and only one of each"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="true"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/test/StructureDefinition/tsis-root-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.valueQuantity">
      <path value="Observation.valueQuantity"/>
      <short value="Observed value"/>
      <mustSupport value="true"/>
    </element>
    <element id="Observation.valueQuantity.value">
      <path value="Observation.valueQuantity.value"/>
      <short value="Observed number"/>
      <mustSupport value="true"/>
    </element>
  </differential>
</StructureDefinition>
