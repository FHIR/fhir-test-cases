<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="l17b-resource"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/l17b-resource"/>
  <name value="L17bResourceName"/>
  <title value="L17b Resource Title"/>
  <status value="draft"/>
  <publisher value="FHIR"/>
  <description value="Type slices Observation.value[x], and gives the slicer a single Quantity type with a profile that has a root invariant: the invariant is merged into the slicer (full)"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="true"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Observation"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.value[x]">
      <path value="Observation.value[x]"/>
      <slicing>
        <discriminator>
          <type value="type"/>
          <path value="$this"/>
        </discriminator>
        <rules value="closed"/>
      </slicing>
      <type>
        <code value="Quantity"/>
        <profile value="http://hl7.org/fhir/test/StructureDefinition/l17b-datatype"/>
      </type>
    </element>
    <element id="Observation.value[x]:valueQuantity">
      <path value="Observation.value[x]"/>
      <sliceName value="valueQuantity"/>
      <type>
        <code value="Quantity"/>
      </type>
    </element>
    <element id="Observation.value[x]:valueQuantity.system">
      <path value="Observation.value[x].system"/>
      <fixedUri value="http://unitsofmeasure.org"/>
    </element>
  </differential>
</StructureDefinition>
