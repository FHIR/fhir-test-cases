<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="empty-base-slices"/>
  <url value="http://hl7.org/fhir/tests/StructureDefinition/empty-base-slices"/>
  <name value="EmptyBaseSlices"/>
  <status value="draft"/>
  <description value="Type-slices an element that the base profile has already sliced without declaring any named slice. findBaseSlices finds nothing, and the base cursor has to fall back to the slicer's own scope instead of indexing off the end of an empty list."/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/tests/StructureDefinition/empty-base-slices-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.value[x]">
      <path value="Observation.value[x]"/>
      <slicing>
        <discriminator>
          <type value="type"/>
          <path value="$this"/>
        </discriminator>
        <rules value="closed"/>
        <ordered value="false"/>
      </slicing>
    </element>
    <element id="Observation.value[x]:valueQuantity">
      <path value="Observation.value[x]"/>
      <sliceName value="valueQuantity"/>
      <type>
        <code value="Quantity"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
