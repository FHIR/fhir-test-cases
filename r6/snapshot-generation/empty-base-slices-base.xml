<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="empty-base-slices-base"/>
  <url value="http://hl7.org/fhir/tests/StructureDefinition/empty-base-slices-base"/>
  <name value="EmptyBaseSlicesBase"/>
  <status value="draft"/>
  <description value="Slices Observation.value[x] by type but declares no named slices, so the snapshot carries a slicing entry with nothing under it."/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Observation"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.value[x]">
      <path value="Observation.value[x]"/>
      <slicing>
        <discriminator>
          <type value="type"/>
          <path value="$this"/>
        </discriminator>
        <rules value="open"/>
        <ordered value="false"/>
      </slicing>
    </element>
  </differential>
</StructureDefinition>
