<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="mapping-suppress"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/mapping-suppress"/>
  <name value="MappingSuppress"/>
  <status value="draft"/>
  <description value="Using elementdefinition-suppress on element mappings (core #2669): the rim mapping statusCode is replaced by Participation.statusCode, and the w5 mapping is removed"/>
  <fhirVersion value="6.0.0-ballot4"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Patient"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.active">
      <path value="Patient.active"/>
      <mapping>
        <extension url="http://hl7.org/fhir/StructureDefinition/elementdefinition-suppress">
          <valueBoolean value="true"/>
        </extension>
        <identity value="rim"/>
        <map value="statusCode"/>
      </mapping>
      <mapping>
        <identity value="rim"/>
        <map value="Participation.statusCode"/>
      </mapping>
      <mapping>
        <extension url="http://hl7.org/fhir/StructureDefinition/elementdefinition-suppress">
          <valueBoolean value="true"/>
        </extension>
        <identity value="w5"/>
        <map value="FiveWs.status"/>
      </mapping>
    </element>
  </differential>
</StructureDefinition>
