<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="sliced-base-with-children"/>
  <url value="http://hl7.org/fhir/tests/StructureDefinition/sliced-base-with-children"/>
  <name value="SlicedBaseWithChildren"/>
  <status value="draft"/>
  <description value="Type-slices an element the base profile has already sliced, where the base also constrains a child of the unsliced element. The base's named slices still have to be found, so the derived slice is matched against the base slice rather than treated as new."/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Observation"/>
  <baseDefinition value="http://hl7.org/fhir/tests/StructureDefinition/sliced-base-with-children-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Observation.value[x]">
      <path value="Observation.value[x]"/>
      <slicing>
        <discriminator>
          <type value="type"/>
          <path value="$this"/>
        </discriminator>
        <rules value="closed"/>
        <ordered value="false"/>
      </slicing>
    </element>
    <element id="Observation.value[x]:valueQuantity">
      <path value="Observation.value[x]"/>
      <sliceName value="valueQuantity"/>
      <type>
        <code value="Quantity"/>
      </type>
      <short value="tightened by the derived profile"/>
    </element>
  </differential>
</StructureDefinition>
