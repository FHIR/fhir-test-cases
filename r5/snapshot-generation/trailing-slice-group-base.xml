<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="trailing-slice-group-base"/>
  <url value="http://hl7.org/fhir/tests/StructureDefinition/trailing-slice-group-base"/>
  <name value="TrailingSliceGroupBase"/>
  <status value="draft"/>
  <description value="Sets up slicing on Patient.link so a derived profile can add named slices without repeating the slicing entry."/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Patient"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.link">
      <path value="Patient.link"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="type"/>
        </discriminator>
        <rules value="open"/>
        <ordered value="false"/>
      </slicing>
    </element>
  </differential>
</StructureDefinition>
