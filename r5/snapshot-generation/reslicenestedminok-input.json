{
  "resourceType": "StructureDefinition",
  "id": "reslicenestedminok",
  "url": "http://hl7.org/fhir/test/StructureDefinition/reslicenestedminok",
  "name": "reslicenestedminok",
  "status": "draft",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Patient.identifier",
        "path": "Patient.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1
      },
      {
        "id": "Patient.identifier:a",
        "path": "Patient.identifier",
        "sliceName": "a",
        "min": 1,
        "max": "*"
      },
      {
        "id": "Patient.identifier:a.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "fixedUri": "http://example.org/a"
      },
      {
        "id": "Patient.identifier:a/b",
        "path": "Patient.identifier",
        "sliceName": "a/b",
        "min": 1,
        "max": "*"
      },
      {
        "id": "Patient.identifier:a/b/c",
        "path": "Patient.identifier",
        "sliceName": "a/b/c",
        "min": 1,
        "max": "1"
      }
    ]
  },
  "description": "Control for reslicenestedmin: the slicer, a and a/b are 1..*, so everything fits"
}