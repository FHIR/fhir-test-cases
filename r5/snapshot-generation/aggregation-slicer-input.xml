<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="aggregation-slicer"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/aggregation-slicer"/>
  <name value="AggregationSlicer"/>
  <status value="draft"/>
  <description value="Control for aggregation-slice: here it's the slicing entry that is bundled and specific, in the same profile. Slicer constraints apply to the slices without being copied into them, so the slice doesn't show them (#733)"/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="MessageHeader"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/MessageHeader"/>
  <derivation value="constraint"/>
  <differential>
    <element id="MessageHeader.focus">
      <path value="MessageHeader.focus"/>
      <slicing>
        <discriminator>
          <type value="profile"/>
          <path value="resolve()"/>
        </discriminator>
        <rules value="open"/>
      </slicing>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://hl7.org/fhir/StructureDefinition/Resource"/>
        <aggregation value="bundled"/>
        <versioning value="specific"/>
      </type>
    </element>
    <element id="MessageHeader.focus:encounter">
      <path value="MessageHeader.focus"/>
      <sliceName value="encounter"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://hl7.org/fhir/StructureDefinition/Encounter"/>
      </type>
    </element>
  </differential>
</StructureDefinition>
