<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="l17-resource"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/l17-resource"/>
  <name value="L17ResourceName"/>
  <title value="L17 Resource Title"/>
  <status value="draft"/>
  <publisher value="FHIR"/>
  <description value="Slices Patient.identifier, and gives the slicer an Identifier profile with a root invariant: the invariant is merged into the slicer (full)"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="true"/>
  <type value="Patient"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Patient"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.identifier">
      <path value="Patient.identifier"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="system"/>
        </discriminator>
        <rules value="open"/>
      </slicing>
      <type>
        <code value="Identifier"/>
        <profile value="http://hl7.org/fhir/test/StructureDefinition/l17-datatype"/>
      </type>
    </element>
    <element id="Patient.identifier:mrn">
      <path value="Patient.identifier"/>
      <sliceName value="mrn"/>
      <max value="1"/>
    </element>
    <element id="Patient.identifier:mrn.system">
      <path value="Patient.identifier.system"/>
      <fixedUri value="http://example.org/mrn"/>
    </element>
  </differential>
</StructureDefinition>
