<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="l17a-resource"/>
  <url value="http://hl7.org/fhir/test/StructureDefinition/l17a-resource"/>
  <name value="L17aResourceName"/>
  <title value="L17a Resource Title"/>
  <status value="draft"/>
  <publisher value="FHIR"/>
  <description value="Derives from l17a-base (a copy of l17-resource) and restates the slicer with the same Identifier profile, adding a slice: the profile comes from the base, so the marker is the base's (full)"/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="true"/>
  <type value="Patient"/>
  <baseDefinition value="http://hl7.org/fhir/test/StructureDefinition/l17a-base"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Patient.identifier">
      <path value="Patient.identifier"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="system"/>
        </discriminator>
        <rules value="open"/>
      </slicing>
      <type>
        <code value="Identifier"/>
        <profile value="http://hl7.org/fhir/test/StructureDefinition/l17-datatype"/>
      </type>
      <min value="1"/>
    </element>
    <element id="Patient.identifier:ssn">
      <path value="Patient.identifier"/>
      <sliceName value="ssn"/>
      <max value="1"/>
    </element>
    <element id="Patient.identifier:ssn.system">
      <path value="Patient.identifier.system"/>
      <fixedUri value="http://example.org/ssn"/>
    </element>
  </differential>
</StructureDefinition>
